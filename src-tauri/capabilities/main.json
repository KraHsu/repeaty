{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window may use Repeaty's native commands.",
  "windows": ["main"],
  "permissions": [
    "allow-mcp-attach",
    "allow-mcp-workspace",
    "allow-mcp-reply",
    "allow-mcp-status",
    "allow-mcp-start",
    "allow-mcp-stop",
    "allow-mcp-configuration",
    "allow-mcp-client-configuration",
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "allow-plugin-host",
    "allow-window-snap-epoch",
    "allow-window-snap-region",
    "allow-desktop-experience-status",
    "allow-desktop-experience-configure",
    "allow-desktop-autostart",
    "allow-desktop-close-action",
    "allow-desktop-cancel-quit",
    "allow-desktop-update-check",
    "allow-desktop-update-download",
    "allow-desktop-update-cancel",
    "allow-desktop-update-install",
    "allow-desktop-diagnostics",
    "allow-workspace-status",
    "allow-workspace-choose",
    "allow-workspace-recent",
    "allow-workspace-close",
    "allow-workspace-restore",
    "allow-open-external",
    "allow-export-begin",
    "allow-export-write",
    "allow-export-finish",
    "allow-export-cancel",
    "allow-workspace-read",
    "allow-workspace-write",
    "allow-workspace-watch",
    "allow-workspace-unwatch",
    "allow-workspace-backups",
    "allow-workspace-backup-cancel",
    "allow-collection-bind-scope",
    "allow-collection-directories",
    "allow-collection-directory-choose",
    "allow-collection-directory-list",
    "allow-collection-directory-read",
    "allow-collection-directory-disconnect",
    "allow-collection-directory-cancel",
    "allow-collection-directory-index",
    "allow-collection-directory-search",
    "allow-collection-download",
    "allow-collection-capture-status",
    "allow-collection-capture-configure",
    "allow-collection-capture-clipboard",
    "allow-collection-capture-take"
  ]
}

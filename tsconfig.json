{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@repeaty-plugins": ["./repeaty.plugins.static.ts"],
      "@repeaty-platform": ["./src/platform/static.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "repeaty.plugins.*.ts",
    "examples/**/*.ts",
    "examples/**/*.vue"
  ]
}

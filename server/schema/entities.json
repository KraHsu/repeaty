      "reviewLimit": { "default": 200, "type": "integer", "minimum": 0, "maximum": 9999 },
      "burySiblings": { "default": true, "type": "boolean" },
      "leechThreshold": { "default": 8, "type": "integer", "minimum": 0, "maximum": 100 },

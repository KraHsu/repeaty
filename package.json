{
  "name": "repeaty",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local-first spaced repetition workspace. Just cards and learning.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test && npm run test:e2e",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "@zip.js/zip.js": "^2.24.0",
    "idb": "^8.0.4",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.1",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.44",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^21.0.3",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KraHsu/repeaty.git"
  }
}
